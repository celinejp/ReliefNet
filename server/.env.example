PORT=3000
# Paste the full URI from Atlas (Connect → Drivers). Hostname must match Atlas exactly.
# Encode password special characters (e.g. @ → %40). Network Access must allow your IP.
MONGODB_URI=mongodb+srv://USER:PASS@YOUR_CLUSTER_HOST.mongodb.net/reliefnet?retryWrites=true&w=majority
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: pin a model id from your Anthropic workspace. If unset, the server discovers ids via the Models API.
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# --- Auth0 (optional). When both issuer + audience are set, GET /api/alerts requires a valid Bearer token.
# ReliefNet tenant (Development): dev-vbjhh7iok0ix176c — issuer must match JWT `iss` (trailing slash OK).
# AUTH0_ISSUER_BASE_URL=https://dev-vbjhh7iok0ix176c.us.auth0.com/
# API Identifier from Auth0 → APIs → ReliefNet API (same value as Flutter --dart-define=AUTH0_AUDIENCE).
# AUTH0_AUDIENCE=https://reliefnet-api
# Comma-separated admin/responder emails (must appear on access token — use an Auth0 Action to add `email` claim).
# ADMIN_EMAILS=ops@yourdomain.com,you@gmail.com
# Optional custom claim namespaces (defaults shown).
# AUTH0_EMAIL_CLAIM_NAMESPACE=https://reliefnet.app/
# AUTH0_ROLE_CLAIM_NAMESPACE=https://reliefnet.app/
#
# --- Auth0 Dashboard (ReliefNet Native app → Settings → Application URIs)
# Paste ONE continuous line (no line breaks), no trailing comma after the last URL, no stray
# characters (e.g. "]"). Spaces after commas can confuse validation — use commas only.
# Put the same line in BOTH "Allowed Callback URLs" AND "Allowed Logout URLs", then Save.
# reliefnet://dev-vbjhh7iok0ix176c.us.auth0.com/android/com.reliefnet.app.relief_net/callback,reliefnet://dev-vbjhh7iok0ix176c.us.auth0.com/ios/com.reliefnet.app.reliefNet/callback,https://dev-vbjhh7iok0ix176c.us.auth0.com/ios/com.reliefnet.app.reliefNet/callback,com.reliefnet.app.reliefNet://dev-vbjhh7iok0ix176c.us.auth0.com/ios/com.reliefnet.app.reliefNet/callback
