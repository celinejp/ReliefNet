# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node dependencies
/node_modules/
**/node_modules/

# Runtime alert stores and upload artifacts
/alerts.json
person_identification/server/uploads/*
